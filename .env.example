# ---- server ----
PORT=5000
# Where the client app is served from — used in emails and referral links
FRONTEND_URL=http://localhost:5173

# ---- database ----
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/invbank

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- first admin (optional) ----
# Set SEED_ADMIN=true once to create the first admin, then remove it.
# The seed is skipped unless both values are present and the password is 10+ chars.
SEED_ADMIN=false
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- email (optional) ----
# Without SMTP config, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Aurivest <no-reply@aurivest.com>
